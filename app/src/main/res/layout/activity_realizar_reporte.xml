<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".RealizarReporteActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:fitsSystemWindows="true">

        <!-- Header blanco con botón menú y título -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menú"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu"
                    android:tint="#111827"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:gravity="center"
                    android:text="Realizar un reporte"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@id/btnMenu"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/btnMenu" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <!-- Contenido principal con Scroll -->
        <ScrollView
            android:id="@+id/svFormulario"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/cvHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <!-- CardView del formulario -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvFormulario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="24dp">

                        <!-- Switch Anónimo -->
                        <TextView
                            android:id="@+id/tvPreguntaAnonimo"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="¿Realizar el reporte de manera anónima?"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switchAnonimo"
                            android:layout_width="45dp"
                            android:layout_height="20dp"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvPreguntaAnonimo"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <!-- Campo Nombre -->
                        <TextView
                            android:id="@+id/tvLabelNombre"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="28dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Nombre"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@id/switchAnonimo"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvNombre"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelNombre"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <EditText
                                android:id="@+id/etNombre"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:enabled="false"
                                android:hint="Usuario automático"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="16sp" />
                        </androidx.cardview.widget.CardView>

                        <!-- Campo Ubicación -->
                        <TextView
                            android:id="@+id/tvLabelUbicacion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Ubicación"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@id/cvNombre"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvUbicacion"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelUbicacion"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <EditText
                                android:id="@+id/etUbicacion"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:hint="Ubicación automática editable"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="16sp" />
                        </androidx.cardview.widget.CardView>

                        <!-- Campo Descripción -->
                        <TextView
                            android:id="@+id/tvLabelDescripcion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Descripción"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@id/cvUbicacion"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvDescripcion"
                            android:layout_width="0dp"
                            android:layout_height="100dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelDescripcion"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <EditText
                                android:id="@+id/etDescripcion"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:gravity="top|start"
                                android:hint="Por favor describa la situación"
                                android:inputType="textMultiLine"
                                android:maxLines="5"
                                android:padding="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="16sp" />
                        </androidx.cardview.widget.CardView>

                        <!-- Label "Evidencia" con botón adjuntar -->
                        <TextView
                            android:id="@+id/tvLabelEvidencia"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Evidencia"
                            android:textColor="#111827"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@id/cvDescripcion"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnAdjuntar" />

                        <!-- Placeholder de evidencia -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvEvidencia"
                            android:layout_width="0dp"
                            android:layout_height="50dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:layout_constraintTop_toBottomOf="@id/tvLabelEvidencia"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <TextView
                                android:id="@+id/tvEvidenciaPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:gravity="center_vertical"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:text="Adjuntar evidencia"
                                android:textColor="#111827"
                                android:textSize="16sp" />
                        </androidx.cardview.widget.CardView>

                        <!-- Botón circular para adjuntar evidencia (alineado a la derecha del contenedor) -->
                        <androidx.cardview.widget.CardView
                            android:id="@+id/btnAdjuntar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:layout_margin="15dp"
                            android:foreground="?attr/selectableItemBackgroundBorderless"
                            android:translationX="12dp"
                            app:cardBackgroundColor="#047857"
                            app:cardCornerRadius="24dp"
                            app:cardElevation="4dp"
                            app:layout_constraintBottom_toBottomOf="@+id/cvEvidencia"
                            app:layout_constraintEnd_toEndOf="@+id/cvEvidencia"
                            app:layout_constraintTop_toTopOf="@+id/cvEvidencia"> <!-- Un ligero desplazamiento para que sobresalga -->

                            <ImageView
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_gravity="center"
                                android:contentDescription="Adjuntar evidencia"
                                android:src="@drawable/ic_upload"
                                android:tint="#FFFFFF" />
                        </androidx.cardview.widget.CardView>

                        <!-- Botones -->
                        <LinearLayout
                            android:id="@+id/llBotones"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="32dp"
                            android:gravity="center"
                            android:orientation="horizontal"
                            app:layout_constraintTop_toBottomOf="@id/cvEvidencia"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnGuardar"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/btn_verde_desbanecido"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingStart="32dp"
                                    android:paddingEnd="32dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Guardar"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnCancelar"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="2dp"
                                app:cardBackgroundColor="#9CA3AF">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:paddingStart="32dp"
                                    android:paddingEnd="32dp"
                                    android:text="Cancelar"
                                    android:textColor="#FFFFFF"
                                    android:textSize="16sp" />
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>
                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menú lateral -->
    <include layout="@layout/nav_drawer_content" />

</androidx.drawerlayout.widget.DrawerLayout>
