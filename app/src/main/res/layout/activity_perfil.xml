<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5"
        android:fitsSystemWindows="true" >

        <!-- Header -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="0dp"
            app:cardElevation="4dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- Boton Menu -->
                <ImageButton
                    android:id="@+id/btnMenu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Menú"
                    android:padding="12dp"
                    android:src="@drawable/ic_menu"
                    android:tint="#111827"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Titulo -->
                <TextView
                    android:id="@+id/tvTitulo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_extrabold"
                    android:text="Perfil del usuario"
                    android:textAlignment="center"
                    android:textColor="#111827"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@id/btnMenu"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@+id/btnMenu"
                    app:layout_constraintTop_toTopOf="@id/btnMenu" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.cardview.widget.CardView>


        <ScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cvHeader">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- formulario -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cvFormulario"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Nombre (No editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/inter_regular"
                            android:text="Nombre"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etNombre"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:hint="Nombre(s) Real"
                                android:inputType="textPersonName"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="false" />

                        </androidx.cardview.widget.CardView>

                        <!-- Apellido P (No editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Apellido Paterno"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etApellidoPaterno"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:hint="Apellido Paterno"
                                android:inputType="textPersonName"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="false" />

                        </androidx.cardview.widget.CardView>

                        <!-- Apellido M (No editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Apellido Materno"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etApellidoMaterno"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:hint="Apellido Materno"
                                android:inputType="textPersonName"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="false" />

                        </androidx.cardview.widget.CardView>

                        <!-- Numero de Casa (No editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Número de Casa"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etNumeroCasa"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:hint="Número de Casa"
                                android:inputType="text"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="false" />

                        </androidx.cardview.widget.CardView>

                        <!-- Calle (No editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Calle"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etCalle"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_extralight_italic"
                                android:hint="Calle"
                                android:inputType="text"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="false" />

                        </androidx.cardview.widget.CardView>

                        <!-- Telefono (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Teléfono"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etTelefono"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="Ingrese su teléfono"
                                android:inputType="phone"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp" />

                        </androidx.cardview.widget.CardView>

                        <!-- Fecha de Nacimiento (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Fecha de Nacimiento"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:id="@+id/cvFechaNacimiento"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:clickable="true"
                            android:focusable="true"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etFechaNacimiento"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="YYYY-MM-DD"
                                android:inputType="none"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp"
                                android:focusable="false"
                                android:clickable="true" />

                        </androidx.cardview.widget.CardView>

                        <!-- Email (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Email"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etEmail"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="Ingrese su email"
                                android:inputType="textEmailAddress"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp" />

                        </androidx.cardview.widget.CardView>

                        <!-- Contraseña (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Contraseña"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etPassword"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="Ingrese nueva contraseña"
                                android:inputType="textPassword"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp" />

                        </androidx.cardview.widget.CardView>

                        <!-- Numero de Tarjeta (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Número de Tarjeta"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etNumeroTarjeta"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="****-****-****-****"
                                android:inputType="number"
                                android:maxLength="19"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp" />

                        </androidx.cardview.widget.CardView>

                        <!-- Fecha de Vencimiento (Editable) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:fontFamily="@font/inter_regular"
                            android:text="Fecha de Vencimiento (Tarjeta)"
                            android:textColor="#111827"
                            android:textSize="14sp" />

                        <androidx.cardview.widget.CardView
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            app:cardBackgroundColor="#E5E7EB"
                            app:cardCornerRadius="8dp"
                            app:cardElevation="0dp">

                            <EditText
                                android:id="@+id/etFechaVencimiento"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@android:color/transparent"
                                android:fontFamily="@font/inter_regular"
                                android:hint="MM-YY"
                                android:inputType="number"
                                android:maxLength="5"
                                android:paddingStart="16dp"
                                android:paddingEnd="16dp"
                                android:textColor="#111827"
                                android:textColorHint="#9CA3AF"
                                android:textSize="14sp" />

                        </androidx.cardview.widget.CardView>

                        <!-- Botones -->
                        <LinearLayout
                            android:id="@+id/llBotones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="24dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnGuardar"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="2dp">

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/btn_verde_desbanecido"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingStart="27dp"
                                    android:paddingEnd="27dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/inter_regular"
                                        android:text="Guardar"
                                        android:textColor="#F8FAFC"
                                        android:textSize="16sp" />
                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnCancelar"
                                android:layout_width="wrap_content"
                                android:layout_height="48dp"
                                android:layout_marginStart="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?attr/selectableItemBackground"
                                app:cardBackgroundColor="#9CA3AF"
                                app:cardCornerRadius="24dp"
                                app:cardElevation="2dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:fontFamily="@font/inter_regular"
                                    android:gravity="center"
                                    android:paddingStart="27dp"
                                    android:paddingEnd="27dp"
                                    android:text="Cancelar"
                                    android:textColor="#F8FAFC"
                                    android:textSize="16sp" />
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu  -->
    <include layout="@layout/nav_drawer_content" />

</androidx.drawerlayout.widget.DrawerLayout>